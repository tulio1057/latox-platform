# API environment. Local: copy to .env.local (used by `npm run dev`).
# Production: set these in the Vercel project of the API (Settings > Environment Variables).
# Never commit real values.

# --- Local development only (Firebase emulators) ---
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
GCLOUD_PROJECT=demo-latox

# --- Production ---
# Service-account JSON of the Firebase project (raw JSON or base64). SECRET.
# FIREBASE_SERVICE_ACCOUNT=

# Exact origins allowed to call state-changing endpoints (comma-separated, no trailing slash).
ALLOWED_ORIGINS=http://localhost:3000

# Shared secret with the website (Vercel env API_PROXY_SECRET of the web project).
# Required in production: requests without it are rejected. Empty locally.
API_PROXY_SECRET=

# AES-256-GCM key for TOTP secrets: 64 hex chars (node -e "console.log(require('crypto').randomBytes(32).toString('hex'))").
# Required in production. Losing it forces every admin to re-enrol their authenticator.
TOTP_ENC_KEY=

# Secret Vercel Cron sends to /api/v1/internal/cleanup.
CRON_SECRET=

# Random secret used to hash IPs in logs and rate limits.
IP_HASH_SALT=change-me
