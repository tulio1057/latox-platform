# Copy to .env.local (emulator) or .env.<project-id> (deploy). Never commit real values.

# Exact origins allowed to call state-changing endpoints (comma-separated, no trailing slash).
ALLOWED_ORIGINS=http://localhost:3000
# production example: ALLOWED_ORIGINS=https://latox.vercel.app,https://www.seudominio.org

# Random secret used to hash IPs in logs and rate limits (e.g. `openssl rand -hex 32`).
IP_HASH_SALT=change-me

# Shared secret with the website (Vercel env API_PROXY_SECRET). Required in production:
# requests without it are rejected. Generate with `openssl rand -hex 32`. Empty locally.
API_PROXY_SECRET=

# Trusted reverse proxies in front of the function (see docs/security).
TRUST_PROXY_HOPS=1

# Function region.
LATOX_REGION=southamerica-east1

# EMULATOR ONLY: the Auth emulator cannot issue TOTP second factors. Ignored outside the emulator.
DEV_ALLOW_NO_MFA=true
