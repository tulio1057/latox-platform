rules_version = '2';

// Defence in depth: browsers never read or write Firestore directly.
// All access goes through the API (Admin SDK), which enforces authentication,
// RBAC, validation and auditing. Any direct client request is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
