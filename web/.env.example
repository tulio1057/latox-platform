# Copy to .env.local for development. These values are PUBLIC (shipped to the browser)
# except API_INTERNAL_URL, which is only used server-side. Never put secrets here.

# Where server components reach the API.
#   dev (emulator): http://127.0.0.1:5001/demo-latox/southamerica-east1/api
#   production:     https://<seu-projeto>.web.app   (goes through Hosting -> /api/** rewrite)
API_INTERNAL_URL=http://127.0.0.1:5001/demo-latox/southamerica-east1/api

# Canonical public URL (sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firebase web app config (Console > Project settings > Your apps). Public identifiers.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-latox.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-latox

# Use the Auth emulator (development only).
NEXT_PUBLIC_USE_AUTH_EMULATOR=true
